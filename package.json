{
  "name": "dsh-usage-insights",
  "version": "1.0.0",
  "private": true,
  "description": "在 DSH 设置里增加「用量查询」：统计官方与第三方接口的请求次数、Token 与费用估算，界面模仿 DeepSeek 官方用量页。",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "usage",
    "tokens",
    "billing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
